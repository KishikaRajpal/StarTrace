# StarTrace Environment Configuration
PROJECT_NAME="StarTrace"
VERSION="1.0.0"

# Database Connection URL
# For local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/startrace
# If PostgreSQL is not active or unreachable, StarTrace will automatically fallback
# gracefully to local SQLite (sqlite:///./startrace.db) with no configuration required.

# Host and Port Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
